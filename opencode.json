{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md",
    "PROJECT_INDEX.md"
  ],
  "tool_output": {
    "max_bytes": 10240
  },
  "compaction": {
    "auto": true,
    "tail_turns": 4
  },
  "provider": {
    "nvidia": {
      "models": {
        "minimaxai/minimax-m3": {
          "limit": {
            "context": 1000000,
            "output": 8192
          },
          "options": {
            "max_tokens": 8192
          }
        }
      }
    },
    "z-ai": {
      "options": {
        "timeout": 600000,
        "headerTimeout": 60000,
        "chunkTimeout": 30000
      },
      "models": {
        "glm-5.2": {
          "limit": {
            "context": 128000,
            "output": 16384
          },
          "options": {
            "max_tokens": 16384
          }
        }
      }
    }
  }
}
