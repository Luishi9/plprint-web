NODE_ENV=production
PORT=3005

# Base de datos MySQL (solo accesible desde localhost)
DATABASE_URL=mysql://DB_USER:DB_PASSWORD@localhost:3306/plprint

# JWT — genera valores seguros con: openssl rand -hex 64
JWT_SECRET=CAMBIA_ESTO_POR_UN_SECRETO_LARGO
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=CAMBIA_ESTO_POR_OTRO_SECRETO_LARGO
JWT_REFRESH_EXPIRES_IN=7d

# CORS — agrega el dominio exacto de tu app en Netlify
# Separa múltiples orígenes con coma, sin espacios
ALLOWED_ORIGINS=https://tu-app.netlify.app,https://tudominio.com

# Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500
