<file path="plprint-web/src/api/auditLog.api.ts">
import { apiClient } from './client';

export interface AuditLog {
  id: number;
  usuario_id: number | null;
  accion: string;
  modulo: string;
  detalle: string | null;
  ip: string | null;
  created_at: string;
