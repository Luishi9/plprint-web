  insumoId: number;
  cantidad: string;
  setCantidad: (v: string) => void;
  precioUnitario: string;
  setPrecioUnitario: (v: string) => void;
  simbolo: string;
  proveedorId: number;
  setProveedorId: (v: number) => void;
