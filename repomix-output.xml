import { VentaCancelarModal } from './VentaCancelarModal';
import {
  buildTicketData, printTicket, printAbonosTicket,
} from './ticketUtils';

export default function VentasPage() {
  const [ventas, setVentas] = useState<Venta[]>([]);
  const [isLoading, setIsLoading] = useState(true);
  const [isSearching, setIsSearching] = useState(false);
  const [searchQuery, setSearchQuery] = useState('');
  const [expandedId, setExpandedId] = useState<number | null>(null);
  const [qrData, setQrData] = useState<TicketData | null>(null);
  const [filtroEstado, setFiltroEstado] = useState<'todas' | 'completada' | 'pendiente_pago' | 'cancelada'>('completada');
  const [ventaACancelar, setVentaACancelar] = useState<Venta | null>(null);
  const [isCanceling, setIsCanceling] = useState(false);
  const [ventaAbonos, setVentaAbonos] = useState<Venta | null>(null);
  const [desde, setDesde] = useState(() => new Date().toISOString().split('T')[0]);
  const [hasta, setHasta] = useState(() => new Date().toISOString().split('T')[0]);
  const [usuarioId, setUsuarioId] = useState<number | undefined>(undefined);
  const [usuarios, setUsuarios] = useState<{ id: number; nombre: string }[]>([]);
  const abortRef = useRef<AbortController | null>(null);
  const { sucursalActiva } = useSucursalStore();
  const { isAdmin } = usePermisos();
  const { src: logoSrc } = useEmpresaLogo();
  const { getLabel: getMetodoLabel } = useMetodosPago();
  const { format: money } = useMoney();
  const navigate = useNavigate();

  function handleReprintTicket(venta: Venta, e: React.MouseEvent) {
    e.stopPropagation();
    printTicket(venta, logoSrc, getMetodoLabel);
  }

  function handleShowQR(venta: Venta, e: React.MouseEvent) {
    e.stopPropagation();
    const subtotal = venta.venta_detalle.reduce(
      (acc, d) => acc + Number(d.precio_unitario) * d.cantidad,
      0,
    );
    setQrData(buildTicketData(venta, subtotal, getMetodoLabel, sucursalActiva?.nombre ?? undefined));
  }

  function handleReprintAbonos(venta: Venta) {
    printAbonosTicket(venta, money as never, getMetodoLabel);
  }

  async function handleCancelarVenta(venta: Venta, e: React.MouseEvent) {
    e.stopPropagation();
    setVentaACancelar(venta);
  }

  async function confirmarCancelacion() {
    if (!ventaACancelar) return;
    try {
      setIsCanceling(true);
      await ventasApi.cancel(ventaACancelar.id);
      setVentaACancelar(null);
      fetchVentas(true);
    } catch (err: unknown) {
      const e = err as { response?: { data?: { message?: string } } };
      sileo.error({ title: e.response?.data?.message || 'No se pudo cancelar la venta.' });
    } finally {
      setIsCanceling(false);
    }
  }

  const fetchVentas = async (isInitial = false) => {
    abortRef.current?.abort();
    abortRef.current = new AbortController();
    if (isInitial) setIsLoading(true);
    else setIsSearching(true);
    try {
      const params: Record<string, unknown> = {};
      if (sucursalActiva) params.sucursalId = sucursalActiva.id;
      if (filtroEstado === 'cancelada') params.estado = 'cancelada';
      else if (filtroEstado === 'completada') params.estado = 'completada';
      else if (filtroEstado === 'pendiente_pago') {
        params.estadoPago = 'pendiente,parcial';
        params.estado = 'completada';
      }
      if (searchQuery.trim()) params.search = searchQuery.trim();
      params.desde = desde;
      params.hasta = hasta;
      if (usuarioId) params.usuarioId = usuarioId;
      const res = await ventasApi.getAll(params);
      const data: Venta[] = res.data?.data || [];
      setVentas(data);
    } catch (err: any) {
      if (err?.code !== 'ERR_CANCELED') console.error(err);
    } finally {
      setIsLoading(false);
      setIsSearching(false);
    }
  };

  useEffect(() => {
    let cancelled = false;
    if (!sucursalActiva) { setIsLoading(false); return; }
    const t = setTimeout(() => {
      (async () => {
        try {
          setIsLoading(true);
          const params: Record<string, unknown> = {};
          if (sucursalActiva) params.sucursalId = sucursalActiva.id;
          if (filtroEstado === 'cancelada') params.estado = 'cancelada';
          else if (filtroEstado === 'completada') params.estado = 'completada';
          else if (filtroEstado === 'pendiente_pago') {
            params.estadoPago = 'pendiente,parcial';
            params.estado = 'completada';
          }
          if (searchQuery.trim()) params.search = searchQuery.trim();
          params.desde = desde;
          params.hasta = hasta;
          if (usuarioId) params.usuarioId = usuarioId;
          const res = await ventasApi.getAll(params);
          if (cancelled) return;
          const data: Venta[] = res.data?.data || [];
          setVentas(data);
        } catch (err: any) {
          if (err?.code !== 'ERR_CANCELED' && !cancelled) console.error(err);
        } finally {
          if (!cancelled) {
            setIsLoading(false);
            setIsSearching(false);
          }
        }
      })();
    }, 300);
    return () => { cancelled = true; clearTimeout(t); };
  }, [sucursalActiva, filtroEstado, desde, hasta, usuarioId, searchQuery]);

  useEffect(() => {
    let cancelled = false;
    if (isAdmin) {
      usuariosApi.getAll({ limit: 100 }).then((res) => {
        if (cancelled) return;
        const data = res.data?.data || [];
        setUsuarios(data.map((u: { id: number; nombre: string }) => ({ id: u.id, nombre: u.nombre })));
      }).catch(() => {});
    }
    return () => { cancelled = true; };
  }, [isAdmin]);

  return (
    <div className="w-full h-full flex flex-col gap-6">
      <VentasHeader
        sucursalNombre={sucursalActiva?.nombre}
        isSearching={isSearching}
        searchQuery={searchQuery}
        onSearchChange={setSearchQuery}
        filtroEstado={filtroEstado}
        onFiltroEstadoChange={setFiltroEstado}
        desde={desde}
        hasta={hasta}
        onDateChange={(d, h) => { setDesde(d); setHasta(h); }}
        isAdmin={isAdmin}
        usuarios={usuarios}
        usuarioId={usuarioId}
        onUsuarioChange={setUsuarioId}
        ventas={ventas}
        onNueva={() => navigate('/ventas/nueva')}
      />

      {/* STAT CARDS */}
      <VentasStats ventas={ventas} money={money as never} />

      {/* TABLE */}
      <VentasTable
        isLoading={isLoading}
        ventas={ventas}
        expandedId={expandedId}
        setExpandedId={setExpandedId}
        money={money as never}
        getMetodoLabel={getMetodoLabel}
        onReprintTicket={handleReprintTicket}
        onShowQR={handleShowQR}
        onAbonos={(venta, e) => { e.stopPropagation(); setVentaAbonos(venta); }}
        onReprintAbonos={handleReprintAbonos}
        onCancelarVenta={handleCancelarVenta}
      />

      <QRTicketModal data={qrData} open={!!qrData} onClose={() => setQrData(null)} />

      <AbonosModal
        open={!!ventaAbonos}
        onOpenChange={(v) => { if (!v) setVentaAbonos(null); }}
        ventaId={ventaAbonos?.id || 0}
        ventaFolio={ventaAbonos?.folio || `#${ventaAbonos?.id || ''}`}
        ventaTotal={Number(ventaAbonos?.total || 0)}
        onAbonoRegistrado={() => fetchVentas(true)}
      />

      {/* MODAL CONFIRMAR CANCELACIÓN */}
      <VentaCancelarModal
        open={!!ventaACancelar}
        venta={ventaACancelar as never}
        isCanceling={isCanceling}
        money={money as never}
        onClose={() => setVentaACancelar(null)}
        onConfirm={confirmarCancelacion}
      />
    </div>
  );
}
</file>

<file path="plprint-api/prisma/schema.prisma">
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model roles {
  id           Int            @id @default(autoincrement())
  nombre       String         @unique @db.VarChar(50)
  descripcion  String?        @db.VarChar(200)
  activo       Boolean        @default(true)
  es_sistema   Boolean        @default(false)
  created_at   DateTime       @default(now())
  updated_at   DateTime       @default(now()) @updatedAt
  usuarios     usuarios[]
  rol_permisos rol_permisos[]
}

model sucursales {
  id                   Int                    @id @default(autoincrement())
  nombre               String                 @db.VarChar(100)
  direccion            String?                @db.Text
  telefono             String?                @db.VarChar(20)
  activa               Boolean                @default(true)
  created_at           DateTime               @default(now())
  updated_at           DateTime               @default(now()) @updatedAt
  inventario           inventario[]
  kardex_movimientos   kardex_movimientos[]
  usuarios_sucursales  usuarios_sucursales[]
  ventas               ventas[]
  mermas               mermas[]
  insumos_inventario   insumos_inventario[]
  gastos               gastos[]
  compras_insumos      compras_insumos[]
  cotizaciones         cotizaciones[]
  maquinas             maquinas[]
  impresiones         impresiones[]
  ordenes_produccion   ordenes_produccion[]
  cortes_caja          cortes_caja[]
  productos            productos[]
}

model usuarios {
  id                  Int                   @id @default(autoincrement())
  nombre              String                @db.VarChar(100)
  email               String                @unique @db.VarChar(150)
  password_hash       String                @db.Text
  rol_id              Int?
  activo              Boolean               @default(true)
  token_version       Int                   @default(0)
  created_at          DateTime              @default(now())
  updated_at          DateTime              @default(now()) @updatedAt
  roles               roles?                @relation(fields: [rol_id], references: [id])
  kardex_movimientos  kardex_movimientos[]
  usuarios_sucursales usuarios_sucursales[]
  ventas              ventas[]
  audit_log           audit_log[]
  gastos              gastos[]
  gastos_autorizados  gastos[]              @relation("autorizado_gastos")
  compras_insumos     compras_insumos[]
  cotizaciones        cotizaciones[]
  ventas_abonos       ventas_abonos[]
  mermas              mermas[]
  impresiones         impresiones[]
  ordenes_creadas     ordenes_produccion[]      @relation("ordenes_creadas")
  ordenes_asignadas   ordenes_produccion[]      @relation("ordenes_asignadas")
  ordenes_historial   ordenes_produccion_historial[]
  cortes_abiertos     cortes_caja[] @relation("caja_apertura")
  cortes_cerrados     cortes_caja[] @relation("caja_cierre")

  @@index([rol_id])
}

model usuarios_sucursales {
  id          Int        @id @default(autoincrement())
  usuario_id  Int
  sucursal_id Int
  usuarios    usuarios   @relation(fields: [usuario_id], references: [id], onDelete: Cascade)
  sucursales  sucursales @relation(fields: [sucursal_id], references: [id], onDelete: Cascade)

  @@unique([usuario_id, sucursal_id])
}

model categorias {
  id         Int        @id @default(autoincrement())
  nombre     String     @db.VarChar(100)
  descripcion String?   @db.VarChar(255)
  tipo       String     @default("venta") @db.VarChar(20) // 'venta' | 'produccion' | 'impresion'
  activo     Boolean    @default(true)
  created_at DateTime   @default(now())
  updated_at DateTime   @default(now()) @updatedAt
  productos  productos[]

  @@index([tipo])
}

model proveedores {
  id         Int         @id @default(autoincrement())
  nombre     String      @db.VarChar(150)
  contacto   String?     @db.VarChar(100)
  telefono   String?     @db.VarChar(20)
  email      String?     @db.VarChar(150)
  rfc        String?     @db.VarChar(20)
  direccion  String?     @db.Text
  notas      String?     @db.Text
  activo     Boolean     @default(true)
  created_at DateTime    @default(now())
  updated_at DateTime    @default(now()) @updatedAt
  productos  productos[]
  insumos    insumos[]
  compras_insumos compras_insumos[]

  @@index([activo])
}

model productos {
  id                 Int                  @id @default(autoincrement())
  codigo             String?              @db.VarChar(50)
  nombre             String               @db.VarChar(150)
  descripcion        String?              @db.Text
  precio_venta       Decimal              @db.Decimal(10, 2)
  precio_compra      Decimal?             @db.Decimal(10, 2)
  categoria_id       Int?
  proveedor_id       Int?
  unidad_medida      String               @default("unidad") @db.VarChar(20)
  imagen_url         String?              @db.Text
  maquina_id         Int?
  activo             Boolean              @default(true)
  cobrar_minimo_1    Boolean              @default(false)
  sucursal_id        Int
  created_at         DateTime             @default(now())
  updated_at         DateTime             @default(now()) @updatedAt
  categorias         categorias?          @relation(fields: [categoria_id], references: [id])
  proveedores        proveedores?         @relation(fields: [proveedor_id], references: [id])
  maquinas           maquinas?            @relation(fields: [maquina_id], references: [id])
  sucursales         sucursales           @relation(fields: [sucursal_id], references: [id])
  inventario         inventario[]
  kardex_movimientos kardex_movimientos[]
  venta_detalle      venta_detalle[]
  producto_insumos   producto_insumos[]
  cotizacion_detalle cotizacion_detalle[]
  mermas             mermas[]
  impresiones        impresiones[]
  ordenes_produccion ordenes_produccion[]
  producto_precios  producto_precios[]

  @@unique([codigo, sucursal_id])
  @@index([categoria_id])
  @@index([activo])
  @@index([maquina_id])
  @@index([sucursal_id])
}

model producto_precios {
  id              Int       @id @default(autoincrement())
  producto_id     Int
  nivel           String    @db.VarChar(20)
  cantidad_minima Int
  precio          Decimal   @db.Decimal(10, 2)
  activo          Boolean   @default(true)
  created_at      DateTime  @default(now())
  updated_at      DateTime  @default(now()) @updatedAt
  productos       productos @relation(fields: [producto_id], references: [id], onDelete: Cascade)

  @@unique([producto_id, nivel])
  @@index([producto_id])
}

model maquinas {
  id                Int          @id @default(autoincrement())
  sucursal_id       Int
  nombre            String       @db.VarChar(100)
  tipo              String       @db.VarChar(50)
  marca             String?      @db.VarChar(50)
  modelo            String?      @db.VarChar(50)
  contador_total    Int          @default(0)
  contador_inicial  Int          @default(0)
  reset_diario      Boolean      @default(false)
  activo            Boolean      @default(true)
  fecha_instalacion DateTime?
  created_at        DateTime     @default(now())
  updated_at        DateTime     @default(now()) @updatedAt
  sucursales        sucursales   @relation(fields: [sucursal_id], references: [id])
  impresiones       impresiones[]
  productos         productos[]
  ordenes_produccion ordenes_produccion[]
  mermas            mermas[]

  @@index([sucursal_id])
  @@index([activo])
}

model impresiones {
  id               Int          @id @default(autoincrement())
  maquina_id       Int
  venta_detalle_id Int?
  venta_id         Int?
  producto_id      Int?
  sucursal_id      Int
  usuario_id       Int?
  fue_merma        Boolean      @default(false)
  merma_id         Int?
  fecha            DateTime     @default(now())
  maquinas         maquinas     @relation(fields: [maquina_id], references: [id])
  ventas           ventas?      @relation(fields: [venta_id], references: [id], onDelete: SetNull)
  productos        productos?   @relation(fields: [producto_id], references: [id])
  sucursales       sucursales   @relation(fields: [sucursal_id], references: [id])
  usuarios         usuarios?    @relation(fields: [usuario_id], references: [id])
  mermas           mermas?      @relation(fields: [merma_id], references: [id])

  @@index([maquina_id, fecha])
  @@index([fecha])
  @@index([producto_id])
}

model inventario {
  id           Int        @id @default(autoincrement())
  producto_id  Int
  sucursal_id  Int
  cantidad     Int        @default(0)
  stock_minimo Int        @default(0)
  stock_maximo Int?
  updated_at   DateTime   @default(now()) @updatedAt
  productos    productos  @relation(fields: [producto_id], references: [id], onDelete: Cascade)
  sucursales   sucursales @relation(fields: [sucursal_id], references: [id], onDelete: Cascade)

  @@unique([producto_id, sucursal_id])
  @@index([producto_id, sucursal_id])
}

model clientes {
  id         Int      @id @default(autoincrement())
  nombre     String   @db.VarChar(150)
  telefono   String?  @db.VarChar(20)
  email      String?  @db.VarChar(150)
  direccion  String?  @db.Text
  activo     Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt
  ventas     ventas[]
  cotizaciones cotizaciones[]
}

model ventas {
  id                 Int                  @id @default(autoincrement())
  folio              String?              @unique @db.VarChar(20)
  sucursal_id        Int?
  cliente_id         Int?
  usuario_id         Int?
  total              Decimal              @db.Decimal(10, 2)
  descuento          Decimal              @default(0) @db.Decimal(10, 2)
  descuento_motivo   String?              @db.VarChar(255)
  metodo_pago        String               @default("efectivo") @db.VarChar(30)
  metodo_pago_id     Int?
  estado             String               @default("completada") @db.VarChar(20)
  estado_pago        String               @default("pagada") @db.VarChar(20)
  saldo_pendiente    Decimal              @default(0) @db.Decimal(10, 2)
  fecha_limite_pago  DateTime?
  cotizacion_id      Int?                 @unique
  notas              String?              @db.Text
  created_at         DateTime             @default(now())
  sucursales         sucursales?          @relation(fields: [sucursal_id], references: [id])
  clientes           clientes?            @relation(fields: [cliente_id], references: [id])
  usuarios           usuarios?            @relation(fields: [usuario_id], references: [id])
  metodos_pago       metodos_pago?        @relation(fields: [metodo_pago_id], references: [id])
  cotizaciones       cotizaciones?
  venta_detalle      venta_detalle[]
  kardex_movimientos kardex_movimientos[]
  ventas_abonos      ventas_abonos[]
  mermas             mermas[]
  impresiones        impresiones[]

  @@index([sucursal_id])
  @@index([cliente_id])
  @@index([created_at])
  @@index([metodo_pago_id])
  @@index([estado_pago])
}

model venta_detalle {
  id                    Int       @id @default(autoincrement())
  venta_id              Int
  producto_id           Int?
  cantidad              Int
  precio_unitario       Decimal   @db.Decimal(10, 2)
  descuento             Decimal   @default(0) @db.Decimal(10, 2)
  subtotal              Decimal   @db.Decimal(10, 2)
  ancho_m               Decimal?  @db.Decimal(10, 4)
  alto_m                Decimal?  @db.Decimal(10, 4)
  unidad_medida_detalle String?   @db.VarChar(20)
  ventas                ventas    @relation(fields: [venta_id], references: [id], onDelete: Cascade)
  productos             productos? @relation(fields: [producto_id], references: [id])
}

model mermas {
  id             Int       @id @default(autoincrement())
  tipo           String    @db.VarChar(20) // 'producto' | 'insumo'
  producto_id    Int?
  insumo_id      Int?
  sucursal_id    Int?
  usuario_id     Int?
  venta_id       Int?
  maquina_id     Int?
  cantidad       Decimal   @db.Decimal(12, 3)
  motivo         String    @db.VarChar(255)
  costo_estimado Decimal?  @db.Decimal(12, 2)
  fecha          DateTime  @default(now())
  created_at     DateTime  @default(now())
  sucursales     sucursales? @relation(fields: [sucursal_id], references: [id])
  usuarios       usuarios?   @relation(fields: [usuario_id], references: [id])
  ventas         ventas?     @relation(fields: [venta_id], references: [id], onDelete: SetNull)
  productos      productos?  @relation(fields: [producto_id], references: [id])
  insumos        insumos?    @relation(fields: [insumo_id], references: [id])
  maquinas       maquinas?   @relation(fields: [maquina_id], references: [id])
  impresiones    impresiones[]

  @@index([tipo])
  @@index([fecha])
  @@index([venta_id])
  @@index([producto_id])
  @@index([insumo_id])
  @@index([maquina_id])
}

model kardex_movimientos {
  id          Int        @id @default(autoincrement())
  producto_id Int?
  sucursal_id Int?
  tipo        String     @db.VarChar(20)
  cantidad    Int
  venta_id    Int?
  referencia  String?    @db.VarChar(100)
  notas       String?    @db.Text
  usuario_id  Int?
  created_at  DateTime   @default(now())
  productos   productos?  @relation(fields: [producto_id], references: [id])
  sucursales  sucursales? @relation(fields: [sucursal_id], references: [id])
  ventas      ventas?     @relation(fields: [venta_id], references: [id], onDelete: SetNull)
  usuarios    usuarios?   @relation(fields: [usuario_id], references: [id])

  @@index([producto_id, sucursal_id])
  @@index([created_at])
}

model insumos {
  id               Int                  @id @default(autoincrement())
  codigo           String               @unique @db.VarChar(50)
  nombre           String               @db.VarChar(150)
  descripcion      String?              @db.Text
  unidad_medida    String               @default("unidad") @db.VarChar(20)
  ancho_rollo      Decimal?             @db.Decimal(10, 4)
  precio_compra    Decimal?             @db.Decimal(10, 2)
  proveedor_id     Int?
  activo           Boolean              @default(true)
  created_at       DateTime             @default(now())
  updated_at       DateTime             @default(now()) @updatedAt
  proveedores      proveedores?         @relation(fields: [proveedor_id], references: [id])
  inventario       insumos_inventario[]
  producto_insumos producto_insumos[]
  compras_insumos  compras_insumos[]
  mermas           mermas[]

  @@index([activo])
}

model compras_insumos {
  id              Int          @id @default(autoincrement())
  sucursal_id     Int?
  proveedor_id    Int?
  usuario_id      Int?
  insumo_id       Int
  cantidad        Decimal      @db.Decimal(12, 3)
  precio_unitario Decimal      @db.Decimal(10, 2)
  total           Decimal      @db.Decimal(12, 2)
  factura         String?      @db.VarChar(100)
  notas           String?      @db.Text
  fecha           DateTime     @default(now())
  created_at      DateTime     @default(now())
  proveedores     proveedores? @relation(fields: [proveedor_id], references: [id])
  insumos         insumos      @relation(fields: [insumo_id], references: [id])
  sucursales      sucursales?  @relation(fields: [sucursal_id], references: [id])
  usuarios        usuarios?    @relation(fields: [usuario_id], references: [id])

  @@index([fecha])
  @@index([proveedor_id])
  @@index([insumo_id])
}

model unidades_medida {
  id          Int      @id @default(autoincrement())
  nombre      String   @unique @db.VarChar(50)
  abreviatura String   @db.VarChar(10)
  es_medida   Boolean  @default(false)
  tipo_medida String?  @db.VarChar(2)
  created_at  DateTime @default(now())
  updated_at  DateTime @default(now()) @updatedAt
}

model gastos_categorias {
  id          Int       @id @default(autoincrement())
  nombre      String    @unique @db.VarChar(100)
  descripcion String?   @db.VarChar(255)
  activo      Boolean   @default(true)
  created_at  DateTime  @default(now())
  updated_at  DateTime  @default(now()) @updatedAt
  gastos      gastos[]
}

model gastos {
  id              Int       @id @default(autoincrement())
  sucursal_id     Int?
  usuario_id      Int?
  categoria_id    Int
  concepto        String    @db.VarChar(200)
  monto           Decimal   @db.Decimal(12, 2)
  tipo            String    @default("gasto") @db.VarChar(20) // 'gasto' | 'ingreso' | 'retiro'
  autorizado_por  Int?
  comprobante_url String?   @db.VarChar(500)
  notas           String?   @db.Text
  fecha           DateTime  @default(now())
  created_at      DateTime  @default(now())
  updated_at      DateTime  @default(now()) @updatedAt
  categoria       gastos_categorias @relation(fields: [categoria_id], references: [id])
  sucursales      sucursales? @relation(fields: [sucursal_id], references: [id])
  usuarios        usuarios?  @relation(fields: [usuario_id], references: [id])
  autorizado      usuarios?  @relation("autorizado_gastos", fields: [autorizado_por], references: [id])

  @@index([fecha])
  @@index([categoria_id])
  @@index([tipo])
  @@index([sucursal_id])
}

model insumos_inventario {
  id           Int        @id @default(autoincrement())
  insumo_id    Int
  sucursal_id  Int
  cantidad     Decimal    @default(0) @db.Decimal(12, 3)
  stock_minimo Decimal    @default(0) @db.Decimal(12, 3)
  updated_at   DateTime   @default(now()) @updatedAt
  insumos      insumos    @relation(fields: [insumo_id], references: [id], onDelete: Cascade)
  sucursales   sucursales @relation(fields: [sucursal_id], references: [id], onDelete: Cascade)

  @@unique([insumo_id, sucursal_id])
  @@index([insumo_id, sucursal_id])
}

model producto_insumos {
  id                 Int       @id @default(autoincrement())
  producto_id        Int
  insumo_id          Int
  cantidad_requerida Decimal   @db.Decimal(12, 3)
  productos          productos @relation(fields: [producto_id], references: [id], onDelete: Cascade, map: "producto_insumos_producto_fkey")
  insumos            insumos   @relation(fields: [insumo_id], references: [id], onDelete: Cascade, map: "producto_insumos_insumo_fkey")

  @@unique([producto_id, insumo_id])
  @@index([producto_id])
  @@index([insumo_id])
}

model configuracion {
  id         Int      @id @default(autoincrement())
  clave      String   @unique @db.VarChar(100)
  valor      String?  @db.Text
  tipo       String   @default("string") @db.VarChar(20)
  grupo      String   @db.VarChar(50)
  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  @@index([grupo])
}

model cotizaciones {
  id                Int                  @id @default(autoincrement())
  folio             String               @unique @db.VarChar(20)
  sucursal_id       Int?
  cliente_id        Int?
  usuario_id        Int?
  total             Decimal              @db.Decimal(10, 2)
  descuento         Decimal              @default(0) @db.Decimal(10, 2)
  descuento_motivo  String?              @db.VarChar(255)
  notas             String?              @db.Text
  estado            String               @default("pendiente") @db.VarChar(20)
  venta_id          Int?                 @unique
  created_at        DateTime             @default(now())
  updated_at        DateTime             @default(now()) @updatedAt
  clientes          clientes?            @relation(fields: [cliente_id], references: [id])
  usuarios          usuarios?            @relation(fields: [usuario_id], references: [id])
  sucursales        sucursales?          @relation(fields: [sucursal_id], references: [id])
  ventas            ventas?              @relation(fields: [venta_id], references: [id])
  cotizacion_detalle cotizacion_detalle[]

  @@index([cliente_id])
  @@index([estado])
  @@index([created_at])
}

model cotizacion_detalle {
  id                    Int          @id @default(autoincrement())
  cotizacion_id         Int
  producto_id           Int
  cantidad              Int
  precio_unitario       Decimal      @db.Decimal(10, 2)
  descuento             Decimal      @default(0) @db.Decimal(10, 2)
  subtotal              Decimal      @db.Decimal(10, 2)
  ancho_m               Decimal?     @db.Decimal(10, 4)
  alto_m                Decimal?     @db.Decimal(10, 4)
  unidad_medida_detalle String?      @db.VarChar(20)
  cotizaciones          cotizaciones @relation(fields: [cotizacion_id], references: [id], onDelete: Cascade)
  productos             productos    @relation(fields: [producto_id], references: [id], map: "cotizacion_detalle_producto_fkey")
}

model ventas_abonos {
  id         Int       @id @default(autoincrement())
  venta_id   Int
  usuario_id Int?
  monto      Decimal   @db.Decimal(10, 2)
  metodo_pago String   @db.VarChar(30)
  notas      String?   @db.VarChar(255)
  fecha      DateTime  @default(now())
  ventas     ventas    @relation(fields: [venta_id], references: [id], onDelete: Cascade)
  usuarios   usuarios? @relation(fields: [usuario_id], references: [id])

  @@index([venta_id])
}

model permisos {
  id           Int            @id @default(autoincrement())
  modulo       String         @db.VarChar(50)
  accion       String         @db.VarChar(50)
  descripcion  String?        @db.VarChar(200)
  created_at   DateTime       @default(now())
  rol_permisos rol_permisos[]

  @@unique([modulo, accion])
  @@index([modulo])
}

model rol_permisos {
  id         Int      @id @default(autoincrement())
  rol_id     Int
  permiso_id Int
  roles      roles    @relation(fields: [rol_id], references: [id], onDelete: Cascade)
  permisos   permisos @relation(fields: [permiso_id], references: [id], onDelete: Cascade)

  @@unique([rol_id, permiso_id])
  @@index([rol_id])
  @@index([permiso_id])
}

model metodos_pago {
  id         Int      @id @default(autoincrement())
  nombre     String   @db.VarChar(50)
  icono      String?  @db.VarChar(30)
  activo     Boolean  @default(true)
  es_sistema Boolean  @default(false)
  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt
  ventas     ventas[]

  @@unique([nombre])
  @@index([activo])
}

model audit_log {
  id         Int       @id @default(autoincrement())
  usuario_id Int?
  accion     String    @db.VarChar(50)
  modulo     String    @db.VarChar(50)
  detalle    String?   @db.Text
  ip         String?   @db.VarChar(45)
  created_at DateTime  @default(now())
  usuarios   usuarios? @relation(fields: [usuario_id], references: [id], onDelete: SetNull)

  @@index([usuario_id])
  @@index([modulo])
  @@index([created_at])
}

model notificaciones_config {
  id         Int      @id @default(autoincrement())
  tipo       String   @unique @db.VarChar(50)
  activo     Boolean  @default(true)
  umbral     Decimal? @db.Decimal(12, 3)
  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt
}

model ordenes_produccion {
  id                   Int      @id @default(autoincrement())
  sucursal_id          Int
  producto_id          Int
  cantidad             Int
  cantidad_producida   Int      @default(0)
  estatus              String   @default("pendiente") @db.VarChar(20)
  prioridad            String   @default("normal") @db.VarChar(15)
  fecha_creacion       DateTime @default(now())
  fecha_inicio         DateTime?
  fecha_fin_estimada   DateTime?
  fecha_fin_real       DateTime?
  usuario_creador_id   Int?
  usuario_asignado_id  Int?
  maquina_id           Int?
  notas                String?  @db.Text
  motivo_cancelacion   String?  @db.Text
  created_at           DateTime @default(now())
  updated_at           DateTime @default(now()) @updatedAt

  sucursales         sucursales  @relation(fields: [sucursal_id], references: [id], onDelete: Restrict)
  productos          productos   @relation(fields: [producto_id], references: [id], onDelete: Restrict)
  maquinas           maquinas?   @relation(fields: [maquina_id], references: [id], onDelete: SetNull)
  usuario_creador    usuarios?   @relation("ordenes_creadas", fields: [usuario_creador_id], references: [id], onDelete: SetNull)
  usuario_asignado   usuarios?   @relation("ordenes_asignadas", fields: [usuario_asignado_id], references: [id], onDelete: SetNull)
  historial          ordenes_produccion_historial[]

  @@index([estatus])
  @@index([sucursal_id])
  @@index([producto_id])
  @@index([usuario_asignado_id])
  @@index([fecha_creacion])
}

model ordenes_produccion_historial {
  id                Int      @id @default(autoincrement())
  orden_id          Int
  estatus_anterior  String?  @db.VarChar(20)
  estatus_nuevo     String   @db.VarChar(20)
  usuario_id        Int?
  notas             String?  @db.Text
  created_at        DateTime @default(now())

  orden             ordenes_produccion @relation(fields: [orden_id], references: [id], onDelete: Cascade)
  usuario           usuarios?          @relation(fields: [usuario_id], references: [id], onDelete: SetNull)

  @@index([orden_id])
  @@index([created_at])
}

model cortes_caja {
  id                   Int       @id @default(autoincrement())
  sucursal_id          Int
  usuario_apertura_id  Int
  fecha_apertura       DateTime  @default(now())
  monto_inicial        Decimal   @db.Decimal(12, 2)
  fecha_cierre         DateTime?
  usuario_cierre_id    Int?
  monto_final_esperado Decimal?  @db.Decimal(12, 2)
  monto_final_real     Decimal?  @db.Decimal(12, 2)
  diferencia           Decimal?  @db.Decimal(12, 2)
  observaciones        String?   @db.Text
  estado               String    @default("abierta") @db.VarChar(10)
  created_at           DateTime  @default(now())
  updated_at           DateTime  @default(now()) @updatedAt

  sucursales       sucursales @relation(fields: [sucursal_id], references: [id])
  usuario_apertura usuarios   @relation("caja_apertura", fields: [usuario_apertura_id], references: [id])
  usuario_cierre   usuarios?  @relation("caja_cierre", fields: [usuario_cierre_id], references: [id])

  @@index([sucursal_id])
  @@index([fecha_apertura])
  @@index([estado])
}

model folio_counter {
  id        Int      @id @default(autoincrement())
  fecha     DateTime @db.Date @unique
  seq       Int      @default(0)
  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt
}
